{
  "name": "bazaarghost-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev --mode local",
    "db:migrate": "python3 scripts/database.py migrate --environment local",
    "db:seed": "python3 scripts/database.py execute --environment local --file worker/fixtures/seed.sql",
    "types": "cf workers types --mode local",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "build": "cf build --mode local"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.2",
    "@types/node": "26.6.5",
    "cf": "1.0.0-beta.17",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "better-auth": "1.7.8",
    "fast-xml-parser": "5.11.2"
  }
}
