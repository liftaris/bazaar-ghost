{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "./.cloudflare/types/index.d.ts",
      "node",
      "@cloudflare/vitest-plugin/types"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true
  },
  "include": [
    "worker/**/*.ts",
    "vitest.config.ts",
    "cloudflare.config.ts",
    "wrangler.config.ts"
  ]
}
